/*
 * ZENIT – MultiTest + PID Balance (Menu 1..5)
 *
 * Mapeamento de modos:
 *  1) Leitura do sensor (ADC/Distância com filtro)
 *  2) Servo Sweep + calibração (checar MIN, MAX e CENTER)
 *  3) Painel interativo (tabela de atalhos: buzzer e Kp/Ki/Kd ao vivo) + Teste de centro
 *  4) Teste Integrado (LED fade + Buzzer + Servo varrendo + Sensor no Serial Plotter)
 *  5) Balança PID (teu "4, nossa versão", ajustável ao vivo)
 *
 * ======= ATALHOS GERAIS NO SERIAL (linha inteira, ex: "kp 9.0") =======
 *  1..5         -> entra no modo
 *  q            -> sair do modo e voltar ao menu
 *  help         -> mostra ajuda
 *  p            -> imprime parâmetros
 *  i            -> inverte o sentido do controle do PID (modo 5)
 *  kp X | ki X | kd X      -> define ganhos do PID
 *  mid X                    -> define alvo (cm, padrão 15.5)
 *  center N | min N | max N -> define ângulos do servo (graus)
 *  form 1|2|3               -> fórmula do sensor (1=power law; 2=6787/(adc-3)-4; 3=linear tosco)
 *  ema X                    -> define alpha do filtro EMA (0..1)
 *  r                        -> zera integrador do PID
 *
 * ======= ATALHOS ESPECÍFICOS DO MODO 3 (interativo) – DIGITE APENAS A TECLA =======
 *  Buzzer:  1=Silêncio  2=Bip curto  3=Bip longo  4=Bip duplo  5=Tremolo  6=Alerta
 *  Kp:      g=0.5 h=1.0 j=2.0 k=4.0 l=8.0
 *  Ki:      m=0.00 n=0.05 o=0.10 p=0.20 r=0.30
 *  Kd:      a=100  s=500  d=1000  f=2000  e=4000
 *  c        -> bip de “centro” (teste rápido)
 *  t        -> reimprime a tabela do modo 3
 *
 * Pinos: Sensor IR A0 | Servo 9 | LED 6 | Buzzer 3
 * Servo de referência: Futaba S3003
 */

#include <Servo.h>
#include <math.h>

#define SERIAL_BAUD 115200

// ==== Hardware pins ====
const int SENSOR_PIN = A0;
const int SERVO_PIN  = 9;
const int LED_PIN    = 6;
const int BUZZER_PIN = 3;

Servo myservo;

// ==== Servo (ajuste conforme seu hardware) ====
int SERVO_CENTER = 82;   // centro mecânico
int SERVO_MIN    = 65;   // limite mecânico seguro
int SERVO_MAX    = 100;  // limite mecânico seguro

// ==== Sensor / distância ====
float MID_CM = 15.5f;     // alvo (meio da régua)
int   sensorFormula = 2;  // 1=power-law; 2=6787/(adc-3)-4 (GP2Y0A21 10–80cm); 3=linear tosco
float emaAlpha = 0.25f;   // filtro EMA
float distEma  = NAN;

// ==== PID (modo 5) ====
float kp = 9.0f, ki = 0.30f, kd = 3900.0f; // teus defaults
float Iacc = 0.0f;
float lastErr = 0.0f;
unsigned long lastPIDms = 0;
bool invertOutput = false;

// PID runtime configuration / presets
int pidPeriodMs = 50; // período de amostragem do PID (ms)
float maxDeltaDeg = 2.0f; // slew-rate default (graus por passo PID)


// Anti-windup
float Imin = -400.0f, Imax = 400.0f;

// Limites de operação
const float MAX_CONTROL_CM = 20.0f; // saturação útil
const float NO_BALL_CM     = 40.0f; // sem bola

// Slew-rate para suavizar servo (graus por passo PID)
bool useSlew = true;

// ==== Estado geral ====
enum Mode { MENU=0, M1_SENSOR, M2_SERVO, M3_INTERATIVO, M4_INTEGRADO, M5_BALANCA };
Mode currentMode = MENU;

// ==== Prototipos ====
void printMenu();
void printHelp();
void printParams();
void printShortcutsMenu();
void handleSerialLine(char *line);
void handleKey_M3(char c);
float readDistanceRaw(int n);
float adcToCm(float adc);
float readDistanceCm(int n);
void buzzerPattern(uint8_t pattern);
void mode1_tick();
void mode2_tick();
void mode3_tick();
void mode4_tick();
void mode5_tick();
void setServoAngle(int ang);

// ==== Util: leitura de linha do Serial ====
const uint8_t RXBUF = 64;
char lineBuf[RXBUF];
uint8_t lineLen = 0;

void setup() {
  Serial.begin(SERIAL_BAUD);
  pinMode(LED_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  myservo.attach(SERVO_PIN);
  myservo.write(SERVO_CENTER);

  Serial.println(F("\nZENIT MultiTest pronto."));
  printMenu();
}

void loop() {
  // ---- Parser de linha (com NL/CR) ----
  while (Serial.available() > 0) {
    char c = Serial.read();
    if (c == '\r' || c == '\n') {
      if (lineLen > 0) {
        lineBuf[lineLen] = '\0';
        handleSerialLine(lineBuf);
        lineLen = 0;
      }
    } else if (lineLen < RXBUF-1) {
      lineBuf[lineLen++] = c;
    }
  }

  // ---- Execução por modo ----
  switch (currentMode) {
    case MENU: /* nada */ break;
    case M1_SENSOR:     mode1_tick(); break;
    case M2_SERVO:      mode2_tick(); break;
    case M3_INTERATIVO: mode3_tick(); break;
    case M4_INTEGRADO:  mode4_tick(); break;
    case M5_BALANCA:    mode5_tick(); break;
  }
}

