  Serial.print(F("Servo: center=")); Serial.print(SERVO_CENTER);
  Serial.print(F(" min=")); Serial.print(SERVO_MIN);
  Serial.print(F(" max=")); Serial.println(SERVO_MAX);
  Serial.print(F("Sensor: form=")); Serial.print(sensorFormula);
  Serial.print(F(" ema=")); Serial.println(emaAlpha, 2);
  Serial.print(F("Alvo (mid cm): ")); Serial.println(MID_CM, 2);
  Serial.print(F("PID: kp=")); Serial.print(kp, 3);
  Serial.print(F(" ki=")); Serial.print(ki, 3);
  Serial.print(F(" kd=")); Serial.println(kd, 3);
  Serial.print(F("Invert=")); Serial.println(invertOutput ? F("ON") : F("OFF"));
  Serial.print(F(" pidPeriodMs=")); Serial.print(pidPeriodMs);
  Serial.print(F(" maxDeltaDeg=")); Serial.println(maxDeltaDeg,2);
  Serial.println(F("==============="));
}

// Menu fixo de atalhos com valores atuais (mostrado ao entrar em qualquer modo)
void printShortcutsMenu() {
  Serial.println(F("\n--- Atalhos Rápidos (valor atual) ---"));
  Serial.print(F("kp ")); Serial.print(kp,2); Serial.print(F("   | "));
  Serial.print(F("ki ")); Serial.print(ki,3); Serial.print(F("   | "));
  Serial.print(F("kd ")); Serial.println(kd,1);

  Serial.print(F("mid ")); Serial.print(MID_CM,2); Serial.print(F("cm   | "));
  Serial.print(F("ema ")); Serial.print(emaAlpha,2); Serial.println(F(" (0..1)"));

  Serial.print(F("center ")); Serial.print(SERVO_CENTER); Serial.print(F("   | "));
  Serial.print(F("min ")); Serial.print(SERVO_MIN); Serial.print(F("   | "));
  Serial.print(F("max ")); Serial.println(SERVO_MAX);

  Serial.print(F("preset normal|rapido|lento   | pidPeriodMs=")); Serial.print(pidPeriodMs);
  Serial.print(F(" maxDeltaDeg=")); Serial.println(maxDeltaDeg,2);

  Serial.println(F("------------------------------------\n"));
}

void handleSerialLine(char *line) {
  // Muda modo se for número simples
  if (strlen(line) == 1 && line[0] >= '1' && line[0] <= '5') {
    currentMode = (Mode)(line[0]-'0');
    if (currentMode == MENU) currentMode = M1_SENSOR;
    Serial.print(F(">> Modo ")); Serial.println((int)currentMode);
  // Mensagem padrão ao entrar em qualquer modo
  Serial.println(F("Para sair e voltar ao menu, aperte 'q'."));
  // Menu fixo de atalhos com os valores ao lado
  printShortcutsMenu();

    if (currentMode == M3_INTERATIVO) {
      Serial.println(F("\n=== Modo 3 – Painel Interativo ==="));
      printHelp();
    }
    if (currentMode == M4_INTEGRADO) {
      Serial.println(F("\n=== Modo 4 – Teste Integrado (use Serial Plotter) ==="));
    }
    if (currentMode == M5_BALANCA) {
      Serial.println(F("\n=== Modo 5 – BALANCA PID ==="));
    }
    return;
  }

  // Comandos curtos
  if (!strcmp(line,"q")) { currentMode = MENU; printMenu(); return; }
  if (!strcmp(line,"help")) { printHelp(); return; }
  if (!strcmp(line,"p")) { printParams(); return; }
  if (!strcmp(line,"i")) { invertOutput = !invertOutput; Serial.println(invertOutput?F("Invertido=ON"):F("Invertido=OFF")); return; }
  if (!strcmp(line,"r")) { Iacc = 0; lastErr=0; Serial.println(F("Integrador zerado.")); return; }

  // Ajustes com valor
  float f; int n;
  if (sscanf(line,"kp %f",&f)==1) { kp=f; Serial.print(F("kp=")); Serial.println(kp,3); return; }
  if (sscanf(line,"ki %f",&f)==1) { ki=f; Serial.print(F("ki=")); Serial.println(ki,3); return; }
  if (sscanf(line,"kd %f",&f)==1) { kd=f; Serial.print(F("kd=")); Serial.println(kd,3); return; }
  if (sscanf(line,"mid %f",&f)==1){ MID_CM=f; Serial.print(F("mid=")); Serial.println(MID_CM,2); return; }
  if (sscanf(line,"ema %f",&f)==1){ emaAlpha=f; Serial.print(F("ema=")); Serial.println(emaAlpha,2); return; }
  if (sscanf(line,"center %d",&n)==1){ SERVO_CENTER=n; setServoAngle(SERVO_CENTER); Serial.print(F("center=")); Serial.println(SERVO_CENTER); return; }
  if (sscanf(line,"min %d",&n)==1){ SERVO_MIN=n; Serial.print(F("min=")); Serial.println(SERVO_MIN); return; }
  if (sscanf(line,"max %d",&n)==1){ SERVO_MAX=n; Serial.print(F("max=")); Serial.println(SERVO_MAX); return; }
  if (sscanf(line,"form %d",&n)==1){ sensorFormula=n; Serial.print(F("form=")); Serial.println(sensorFormula); return; }
  // Preset de comportamento da balança (cinética)
  if (sscanf(line,"preset %s", line)==1) {
    // não usamos aqui; fallback abaixo com strcmp simples
  }

  // Também aceita formato antigo: "P 9.0", "I 0.3", "D 3900"
  char C; float v;
  if (sscanf(line,"%c %f",&C,&v)==2) {
    if (C=='P'||C=='p'){ kp=v; Serial.print(F("kp=")); Serial.println(kp,3); return; }
    if (C=='I'||C=='i'){ ki=v; Serial.print(F("ki=")); Serial.println(ki,3); return; }
    if (C=='D'||C=='d'){ kd=v; Serial.print(F("kd=")); Serial.println(kd,3); return; }
  }

  // No modo 3, teclas single-char de atalho
  if (currentMode==M3_INTERATIVO && strlen(line)==1) {
    handleKey_M3(line[0]);
    return;
  }
  // Comando preset (ex: preset normal|rapido|lento)
  if (strncmp(line, "preset ", 7) == 0) {
    const char *arg = line + 7;
    if (!strcmp(arg, "normal")) {
      kp = 9.0f; ki = 0.30f; kd = 3900.0f; pidPeriodMs = 50; maxDeltaDeg = 2.0f;
      Serial.println(F("Preset: NORMAL aplicado.")); printParams(); return;
    } else if (!strcmp(arg, "rapido")) {
      kp = 12.0f; ki = 0.50f; kd = 5000.0f; pidPeriodMs = 30; maxDeltaDeg = 4.0f;
      Serial.println(F("Preset: RAPIDO aplicado.")); printParams(); return;
    } else if (!strcmp(arg, "lento")) {
      kp = 6.0f; ki = 0.12f; kd = 2000.0f; pidPeriodMs = 80; maxDeltaDeg = 1.0f;
      Serial.println(F("Preset: LENTO aplicado.")); printParams(); return;
    } else {
      Serial.println(F("Preset desconhecido. Use: normal, rapido ou lento.")); return;
    }
  }

  Serial.println(F("Comando nao reconhecido. (help)"));
}

// ==================== Sensor ====================
float readDistanceRaw(int n) {
  long sum=0;
  if (n<1) n=1;
  for (int i=0;i<n;i++) sum += analogRead(SENSOR_PIN);
  return (float)sum/(float)n;
}

float adcToCm(float adc) {
  float cm = 0;
  if (sensorFormula==1) {
    // Power-law genérico (ajuste comum pra Sharp)
    cm = 17569.7 * pow(adc, -1.2062);
  } else if (sensorFormula==2) {
    // Tua fórmula usada (GP2Y0A21)
    cm = 6787.0f / (adc - 3.0f) - 4.0f;
  } else {
    // Linear tosca (fallback)
    cm = map((int)adc, 1023, 100, 10, 80); // só pra não quebrar
  }
  if (cm < 0 || cm > 100) return NO_BALL_CM;
  return cm;
}

float readDistanceCm(int n) {
  float adc = readDistanceRaw(n);
  float cm  = adcToCm(adc);
  // EMA
  if (isnan(distEma)) distEma = cm;
  distEma = emaAlpha*cm + (1.0f-emaAlpha)*distEma;
  return distEma;
}

// ==================== Aux ====================
void setServoAngle(int ang) {
  ang = constrain(ang, SERVO_MIN, SERVO_MAX);
  myservo.write(ang);
}

void buzzerPattern(uint8_t pattern) {
  switch(pattern) {
    case 1: noTone(BUZZER_PIN); break;
    case 2: tone(BUZZER_PIN, 1500, 100); break;
    case 3: tone(BUZZER_PIN, 1200, 400); break;
    case 4: tone(BUZZER_PIN, 1400, 120); delay(150); tone(BUZZER_PIN, 1400, 120); break;
    case 5: for (int i=0;i<8;i++){ tone(BUZZER_PIN, 1000+ (i%2)*500, 40); delay(50);} break;
    case 6: tone(BUZZER_PIN, 900, 800); break;
  }
}

// ==================== Modos ====================

// Modo 1 – Leitura do sensor
void mode1_tick() {
  static unsigned long t0=0;
  if (millis()-t0 < 100) return;
  t0 = millis();

  float adc = readDistanceRaw(50);
  float cm  = readDistanceCm(1); // já filtrado pela EMA
  Serial.print(F("ADC=")); Serial.print(adc,1);
  Serial.print(F("\tDist(cm)=")); Serial.println(cm,2);
}

// Modo 2 – Servo sweep + calibração
void mode2_tick() {
  static int ang = SERVO_MIN;
  static int dir = +1;
  static unsigned long t0=0;
  if (millis()-t0 < 20) return;
  t0 = millis();

  setServoAngle(ang);
  ang += dir;
  if (ang<=SERVO_MIN) dir=+1;
  if (ang>=SERVO_MAX) dir=-1;

  // Mostra distância junto
  float cm = readDistanceCm(5);
  Serial.print(F("ang=")); Serial.print(ang);
  Serial.print(F("\tcm=")); Serial.println(cm,2);
}

// Modo 3 – Painel interativo
void handleKey_M3(char c) {
  switch(c) {
    // Buzzer
    case '1': buzzerPattern(1); Serial.println(F("Buzzer: silencio")); break;
    case '2': buzzerPattern(2); Serial.println(F("Buzzer: bip curto")); break;
    case '3': buzzerPattern(3); Serial.println(F("Buzzer: bip longo")); break;
    case '4': buzzerPattern(4); Serial.println(F("Buzzer: bip duplo")); break;
    case '5': buzzerPattern(5); Serial.println(F("Buzzer: tremolo")); break;
    case '6': buzzerPattern(6); Serial.println(F("Buzzer: alerta")); break;

    // Kp presets
    case 'g': kp=0.5;  Serial.println(F("kp=0.5"));  break;
    case 'h': kp=1.0;  Serial.println(F("kp=1.0"));  break;
    case 'j': kp=2.0;  Serial.println(F("kp=2.0"));  break;
    case 'k': kp=4.0;  Serial.println(F("kp=4.0"));  break;
    case 'l': kp=8.0;  Serial.println(F("kp=8.0"));  break;

    // Ki presets
    case 'm': ki=0.00; Serial.println(F("ki=0.00")); break;
    case 'n': ki=0.05; Serial.println(F("ki=0.05")); break;
    case 'o': ki=0.10; Serial.println(F("ki=0.10")); break;
    case 'p': ki=0.20; Serial.println(F("ki=0.20")); break;
    case 'r': ki=0.30; Serial.println(F("ki=0.30")); break;

    // Kd presets
    case 'a': kd=100;  Serial.println(F("kd=100"));  break;
    case 's': kd=500;  Serial.println(F("kd=500"));  break;
    case 'd': kd=1000; Serial.println(F("kd=1000")); break;
    case 'f': kd=2000; Serial.println(F("kd=2000")); break;
    case 'e': kd=4000; Serial.println(F("kd=4000")); break;

    // Teste de centro
    case 'c': setServoAngle(SERVO_CENTER); digitalWrite(LED_PIN,HIGH); tone(BUZZER_PIN,1500,120); delay(150); digitalWrite(LED_PIN,LOW); break;

    // Reimprime tabela
    case 't': printHelp(); break;

    default: Serial.println(F("(tecla do modo 3 nao mapeada)"));
  }
}

void mode3_tick() {
  static unsigned long t0=0;
  if (millis()-t0 < 300) return;
  t0 = millis();

  float cm = readDistanceCm(10);
  float err = MID_CM - min(cm, MAX_CONTROL_CM);
  // Se estiver no centro ±0.5 cm, acende LED
  if (fabs(err) <= 0.5) { digitalWrite(LED_PIN, HIGH); } else { digitalWrite(LED_PIN, LOW); }
  Serial.print(F("cm=")); Serial.print(cm,2);
  Serial.print(F("\tkp=")); Serial.print(kp,2);
  Serial.print(F(" ki=")); Serial.print(ki,2);
  Serial.print(F(" kd=")); Serial.println(kd,1);
}

// Modo 4 – Teste integrado (baseado no teu #1, não-bloqueante)
void mode4_tick() {
  static int brilho=0, dir=+5;
  static unsigned long t0=0;
  if (millis()-t0 < 30) return;
  t0 = millis();

  brilho += dir;
  if (brilho>=255) { brilho=255; dir=-5; }
  if (brilho<=0)   { brilho=0;   dir=+5; }

  analogWrite(LED_PIN, brilho);
  tone(BUZZER_PIN, 1000);

  int ang = map(brilho, 0, 255, 60, 120);
  setServoAngle(ang);

  int sensorValue = (int)readDistanceRaw(5); // ADC cru pra plotter
  Serial.print(F("LED:"));    Serial.print(brilho);
  Serial.print(F("\tServo:")); Serial.print(ang);
  Serial.print(F("\tSensor:")); Serial.println(sensorValue);
}

// Modo 5 – BALANÇA PID (teu #4 ajustado)
void mode5_tick() {
  static unsigned long t0 = 0;
  unsigned long now = millis();
  if (now - t0 < (unsigned long)pidPeriodMs) return;
  float dt = (now - t0) / 1000.0f;
  t0 = now;

  // proteções básicas
  if (dt <= 0.0f) dt = 1e-3f;
  if (dt > 1.0f) dt = 1.0f; // evita saltos grandes

  float distance = readDistanceCm(50);

  // Modo "sem bola"
  if (distance >= NO_BALL_CM) {
    setServoAngle(SERVO_CENTER);
    digitalWrite(LED_PIN, LOW);
    noTone(BUZZER_PIN);
    Iacc = 0; lastErr = 0;
    Serial.println(F("ESPERA: sem bola."));
    return;
  }

  // Saturação útil
  float dctrl = distance;
  if (dctrl > MAX_CONTROL_CM) dctrl = MAX_CONTROL_CM;

  // Erro
  float err = MID_CM - dctrl;

  // Deadband no centro
  if (fabs(err) <= 0.3f) {
    setServoAngle(SERVO_CENTER);
    Iacc = 0; lastErr=0;
    digitalWrite(LED_PIN, HIGH);
    tone(BUZZER_PIN, 1500, 100);
    Serial.println(F("Equilibrado (deadband)."));
    return;
  }


  // PID
  float P = kp * err;
  float D = kd * ((err - lastErr) / dt);

  // Integral só perto do alvo
  if (fabs(err) < 3.0f) {
    Iacc += ki * err * dt;
    // anti-windup: clamp
    if (Iacc > Imax) Iacc = Imax;
    if (Iacc < Imin) Iacc = Imin;
  } else {
    // quando longe do alvo, diminui integral suavemente
    Iacc *= 0.9f;
  }

  float u = P + Iacc + D;
  if (invertOutput) u = -u;

  // limitar o controle para evitar intruções extremas ao servo
  const float Umax = 40.0f; // graus máxima contribuição do PID
  if (u > Umax) u = Umax;
  if (u < -Umax) u = -Umax;

  // Aplica no servo ao redor do centro com slew-rate
  static int lastAng = SERVO_CENTER;
  int targetAng = SERVO_CENTER + (int)round(u);
  if (useSlew) {
    int delta = targetAng - lastAng;
    int maxStep = (int)round(maxDeltaDeg);
    if (delta > maxStep) targetAng = lastAng + maxStep;
    if (delta < -maxStep) targetAng = lastAng - maxStep;
  }
  setServoAngle(targetAng);
  lastAng = targetAng;
  lastErr = err;

  // Indicadores (fora do centro)
  digitalWrite(LED_PIN, LOW);
  noTone(BUZZER_PIN);

  // Debug compacto
  Serial.print(F("[Balanca] Dist=")); Serial.print(distance,1);
  Serial.print(F("cm Err=")); Serial.print(err,2);
  Serial.print(F(" U=")); Serial.print(u,2);
  Serial.print(F(" Ang=")); Serial.print(targetAng);
  Serial.print(F(" kp=")); Serial.print(kp,2);
  Serial.print(F(" ki=")); Serial.print(ki,3);
  Serial.print(F(" kd=")); Serial.println(kd,1);
}
