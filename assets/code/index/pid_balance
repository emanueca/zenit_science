#include <Servo.h>

// --- Configurações de Hardware ---
const int SENSOR_PIN = A0;
const int LED_PIN    = 6;
const int BUZZER_PIN = 3;
Servo myservo;

// --- Configurações do Servo Motor (ângulo) ---
const int SERVO_CENTRO     = 75; 
const int SERVO_MIN_ANGULO = 68; 
const int SERVO_MAX_ANGULO = 101; 

// --- Controle de Tempo ---
unsigned long time_prev = 0;
const unsigned long PERIOD_MS = 40UL; // ~25Hz

// --- Configurações do Sensor ---
const float NO_BALL_CM = 40.0f;        
const float MIN_CONTROL_CM = 2.0f;     
float distance_filtered = 0.0f;        
const float DIST_FILTER_ALPHA = 0.65f; 

// --- Controle PID ---
const float kp_near = 3.0f;   
const float kp_far = 1.5f;    
const float ERROR_THRESHOLD_CM = 2.0f; 
float ki = 0.20f; 
float kd = 8.0f;   
 
float PID_p = 0.0f, PID_i = 0.0f, PID_d = 0.0f;
const float INTEGRAL_MAX = 100.0f; 

// --- Estado do PID ---
float distance_previous_error = 0.0f;
float last_derivative = 0.0f;
const float D_FILTER_ALPHA = 0.95f; 

// --- Setpoint ---
const float distance_setpoint = 11.35f;   
const float CENTER_DEADBAND = 0.50f;      
const float BEEP_FREQUENCY = 2700;        

// --- Histerese do Servo Motor (ângulo) ---
const int ANGLE_HYSTERESIS = 1; 
int lastCommandedAngle = SERVO_CENTRO;


void setup() {
  Serial.begin(115200);
  myservo.attach(9);
  myservo.write(SERVO_CENTRO);
  pinMode(LED_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  distance_filtered = read_distance_raw(10);
  PID_i = 0.0f;
  distance_previous_error = 0.0f;
  time_prev = millis();
  Serial.println("ZENIT - PID Corrigido Iniciado (Sintonia Refinada)");
}

void loop() {
  unsigned long now = millis();
  if (now - time_prev < PERIOD_MS) return;
  float dt = (now - time_prev) / 1000.0f;
  if (dt <= 0) dt = 0.001f;
  time_prev = now;

  float d_raw = read_distance_raw(10);

  if (d_raw >= NO_BALL_CM) {
    writeServoIfNeeded(SERVO_CENTRO);
    digitalWrite(LED_PIN, LOW);
    noTone(BUZZER_PIN);
    PID_i = 0.0f;
    distance_previous_error = 0.0f;
    Serial.println("SEM BOLA -> CENTRO");
    return;
  }
  
  if (d_raw < MIN_CONTROL_CM) {
    d_raw = MIN_CONTROL_CM;
  }

  distance_filtered = DIST_FILTER_ALPHA * distance_filtered + (1.0f - DIST_FILTER_ALPHA) * d_raw;

  float error = distance_setpoint - distance_filtered;

  if (fabs(error) <= CENTER_DEADBAND) {
    writeServoIfNeeded(SERVO_CENTRO);
    PID_i = 0.0f;
    distance_previous_error = error;
    digitalWrite(LED_PIN, HIGH);
    tone(BUZZER_PIN, BEEP_FREQUENCY); 
    
    // Debug central
    Serial.print("Servo Motor (Angulo):"); Serial.print(SERVO_CENTRO);
    Serial.print("\tP (Sensor):"); Serial.print(distance_filtered, 3);
    Serial.print("\tI:"); Serial.print(0);
    Serial.print("\tD:"); Serial.print(0);
    Serial.print("\tAngulo:"); Serial.println(SERVO_CENTRO);
    return;
  } else {
    digitalWrite(LED_PIN, LOW); 
    noTone(BUZZER_PIN);
  }

  float current_kp;
  if (fabs(error) > ERROR_THRESHOLD_CM) {
    current_kp = kp_far; 
  } else {
    current_kp = kp_near; 
  }
  
  PID_p = current_kp * error;
  PID_i += ki * error * dt;
  PID_i = constrain(PID_i, -INTEGRAL_MAX, INTEGRAL_MAX);

  float raw_d = (error - distance_previous_error) / dt;
  float d_filtered = D_FILTER_ALPHA * last_derivative + (1.0f - D_FILTER_ALPHA) * raw_d;
  last_derivative = d_filtered;
  PID_d = kd * d_filtered;

  float pid_output = PID_p + PID_i + PID_d;

  int angulo_final = SERVO_CENTRO + (int)round(pid_output);
  angulo_final = constrain(angulo_final, SERVO_MIN_ANGULO, SERVO_MAX_ANGULO);
  writeServoIfNeeded(angulo_final);

  distance_previous_error = error;
  
  // --- Debug via Serial (formatado para Plotter) ---
  Serial.print("Servo Motor (Angulo):"); Serial.print(angulo_final);
  Serial.print("\tP (Sensor):"); Serial.print(distance_filtered, 3);
  Serial.print("\tI:"); Serial.print(PID_i, 3);
  Serial.print("\tD:"); Serial.print(PID_d, 3);
  Serial.print("\tAngulo:"); Serial.println(angulo_final);
}

void writeServoIfNeeded(int ang) {
  if (abs(ang - lastCommandedAngle) >= ANGLE_HYSTERESIS) {
    myservo.write(ang);
    lastCommandedAngle = ang;
  }
}

float read_distance_raw(int n) {
  long sum = 0;
  for (int i = 0; i < n; i++) {
    sum += analogRead(SENSOR_PIN);
    delay(2);
  }
  float adc = (float)sum / (float)n;
  float distance_cm = 6787.0 / (adc - 3.0) - 4.0; 
  
  if (distance_cm < 0.0f || distance_cm > 100.0f) {
    return NO_BALL_CM;
  }
  return distance_cm;
}
