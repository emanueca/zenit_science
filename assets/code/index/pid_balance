/*
 * ZENIT - Versão corrigida: anti-jitter, filtro, deadband e inicialização PID
 */
#include <Servo.h>

// hardware
const int SENSOR_PIN = A0;
const int ledPin     = 6;
const int buzzerPin  = 3;
Servo myservo;

// servo / limites
const int SERVO_CENTRO     = 72;
const int SERVO_MIN_ANGULO = 50;
const int SERVO_MAX_ANGULO = 95;

// controle tempo
unsigned long time_prev = 0;
const unsigned long PERIOD_MS = 40UL; // loop ~25Hz (mais estável)
unsigned long lastBeep = 0;

// sensor / leitura
const float NO_BALL_CM = 40.0f;
const float MAX_CONTROL_CM = 20.0f;
float distance_filtered = 0.0f;
const float DIST_FILTER_ALPHA = 0.65f; // 0..1 (maior = mais suave)

// PID (valores iniciais mais conservadores)
float kp = 3.0f;
float ki = 0.02f;
float kd = 1.2f;
float PID_p = 0.0f, PID_i = 0.0f, PID_d = 0.0f;
const float INTEGRAL_MAX = 100.0f;

// estados PID
float distance_previous_error = 0.0f;
float last_derivative = 0.0f;
const float D_FILTER_ALPHA = 0.75f;

// tolerâncias / deadband
const float distance_setpoint = 11.35f;
const float toleranciaCentro = 0.8f;       // zona ampla que considera "centro"
const float CENTER_DEADBAND = 0.45f;      // se |erro| <= deadband -> vai pro centro
const float CENTER_DISTANCE_TOL = 0.20f;  // bip apenas se muito preciso
const unsigned long BEEP_INTERVAL_MS = 500UL;

// servo hysteresis
const int ANGLE_HYSTERESIS = 1; // só escreve se mudança >= 1 grau
int lastCommandedAngle = SERVO_CENTRO;

void setup() {
  Serial.begin(115200);
  myservo.attach(9);
  myservo.write(SERVO_CENTRO);
  pinMode(ledPin, OUTPUT);
  pinMode(buzzerPin, OUTPUT);
  // inicializa filtros com a primeira leitura
  distance_filtered = read_distance_raw(10);
  PID_i = 0.0f; // inicializa integral
  distance_previous_error = 0.0f;
  time_prev = millis();
  Serial.println("ZENIT - PID estável iniciado");
}

void loop() {
  unsigned long now = millis();
  if (now - time_prev < PERIOD_MS) return;
  float dt = (now - time_prev) / 1000.0f;
  if (dt <= 0) dt = 0.001f;
  time_prev = now;

  // leitura
  float d_raw = read_distance_raw(10);
  if (d_raw >= NO_BALL_CM) {
    // sem bola: centro e reset
    writeServoIfNeeded(SERVO_CENTRO);
    digitalWrite(ledPin, LOW);
    noTone(buzzerPin);
    PID_i = 0.0f;
    distance_previous_error = 0.0f;
    Serial.println("SEM BOLA -> CENTRO");
    return;
  }

  // clamp
  if (d_raw > MAX_CONTROL_CM) d_raw = MAX_CONTROL_CM;

  // filtro exponencial
  distance_filtered = DIST_FILTER_ALPHA * distance_filtered + (1.0f - DIST_FILTER_ALPHA) * d_raw;

  // erro (setpoint - leitura)
  float error = distance_setpoint - distance_filtered;

  // deadband: se muito próximo do centro -> vai pro centro e zera integral
  if (fabs(error) <= CENTER_DEADBAND) {
    writeServoIfNeeded(SERVO_CENTRO);
    PID_i = 0.0f;
    distance_previous_error = 0.0f;
    digitalWrite(ledPin, HIGH);

    // beep apenas quando está realmente estável (pequena margem)
    static int stableCount = 0;
    if (fabs(distance_filtered - distance_setpoint) <= CENTER_DISTANCE_TOL) stableCount++; else stableCount = 0;
    if (stableCount >= 3 && (now - lastBeep) >= BEEP_INTERVAL_MS) {
      tone(buzzerPin, 1500, 80);
      lastBeep = now;
    }
    Serial.print("Estavel centro. Dist: "); Serial.println(distance_filtered, 3);
    return;
  } else {
    digitalWrite(ledPin, LOW);
  }

  // --- PID ---
  PID_p = kp * error;

  // integral com anti-windup
  PID_i += ki * error * dt;
  if (PID_i > INTEGRAL_MAX) PID_i = INTEGRAL_MAX;
  if (PID_i < -INTEGRAL_MAX) PID_i = -INTEGRAL_MAX;

  // derivativo e filtragem do D
  float raw_d = (error - distance_previous_error) / dt;
  float d_filtered = D_FILTER_ALPHA * last_derivative + (1.0f - D_FILTER_ALPHA) * raw_d;
  last_derivative = d_filtered;
  PID_d = kd * d_filtered;

  float pid_output = PID_p + PID_i + PID_d; // unidades aproximadas em graus

  // converte para ângulo
  int angulo_final = SERVO_CENTRO + (int)round(pid_output);

  // garante limites
  angulo_final = constrain(angulo_final, SERVO_MIN_ANGULO, SERVO_MAX_ANGULO);

  // só escreve se mudança significativa (histerese)
  writeServoIfNeeded(angulo_final);

  // debug
  Serial.print("Dist(f):"); Serial.print(distance_filtered,3);
  Serial.print(" Err:"); Serial.print(error,3);
  Serial.print(" P:"); Serial.print(PID_p,3);
  Serial.print(" I:"); Serial.print(PID_i,3);
  Serial.print(" D:"); Serial.print(PID_d,3);
  Serial.print(" Ang:"); Serial.println(lastCommandedAngle);

  distance_previous_error = error;
}

// escreve no servo apenas quando necessário
void writeServoIfNeeded(int ang) {
  if (abs(ang - lastCommandedAngle) >= ANGLE_HYSTERESIS) {
    myservo.write(ang);
    lastCommandedAngle = ang;
  }
}

// leitura crua média
float read_distance_raw(int n) {
  long sum = 0;
  for (int i = 0; i < n; i++) {
    sum += analogRead(SENSOR_PIN);
    delay(2);
  }
  float adc = (float)sum / (float)n;
  float distance_cm = 6787.0 / (adc - 3.0) - 4.0;
  if (distance_cm < 0.0f || distance_cm > 100.0f) return NO_BALL_CM;
  return distance_cm;
}
