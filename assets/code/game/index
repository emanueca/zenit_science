#include <Servo.h>

// --- Configurações de Hardware ---
const int SENSOR_PIN = A0;
const int LED_PIN    = 6;
const int BUZZER_PIN = 3;
Servo myservo;

// --- Configurações do Servo ---
const int SERVO_CENTRO     = 72;
const int SERVO_MIN_ANGULO = 60;
const int SERVO_MAX_ANGULO = 99;

// --- Controle de Tempo ---
unsigned long time_prev = 0;
const unsigned long PERIOD_MS = 40UL; // Período do loop em ms (~25Hz)

// --- Configurações do Sensor ---
const float NO_BALL_CM = 40.0f;
const float MIN_CONTROL_CM = 2.0f;

// --- Controle PID SIMPLIFICADO ---
float kp = 3.0f;  // Kp único e simplificado
float ki = 0.20f;
float kd = 8.0f;

// --- Interface Serial ---
char serialBuffer[32];
int bufferIndex = 0;
bool systemActive = true;

// Estrutura para armazenar configurações originais do PID (simplificada)
struct {
    float kp;
    float ki;
    float kd;
} defaultPID = {3.0f, 0.20f, 8.0f};
 
float PID_p = 0.0f, PID_i = 0.0f, PID_d = 0.0f;
const float INTEGRAL_MAX = 100.0f; // Limite do termo integral (anti-windup)

// --- Estado do PID ---
float distance_previous_error = 0.0f;

// --- Setpoint e Tolerâncias ---
const float distance_setpoint = 11.35f;
const float CENTER_DEADBAND = 0.50f;
const float BEEP_FREQUENCY = 2700;

// --- Histerese do Servo ---
const int ANGLE_HYSTERESIS = 1;
int lastCommandedAngle = SERVO_CENTRO;


void setup() {
  Serial.begin(115200);
  myservo.attach(9);
  myservo.write(SERVO_CENTRO);
  pinMode(LED_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  PID_i = 0.0f;
  distance_previous_error = 0.0f;
  time_prev = millis();
  
  // Menu inicial
  showMenu();
}

void showMenu() {
  Serial.println("\n====== ZENIT - Controle PID (Simples) ======");
  Serial.println("Comandos Disponiveis:");
  Serial.println("  p<valor> : Ajusta Kp (ex: p8.0)");
  Serial.println("  i<valor> : Ajusta Ki (ex: i0.5)");
  Serial.println("  d<valor> : Ajusta Kd (ex: d4.2)");
  Serial.println("  l        : Lista os valores PID atuais");
  Serial.println("  r        : Reseta TODOS os valores PID para o padrao");
  Serial.println("  s        : Para/Inicia o sistema de controle");
  Serial.println("  k        : Mostra este menu de ajuda");
  Serial.println("==========================================");
}

void processSerialCommand() {
  if (!Serial.available()) return;
  
  char c = Serial.read();
  if (c == '\n' || c == '\r') {
    serialBuffer[bufferIndex] = 0;
    
    if (bufferIndex > 0) {
      float value;
      switch(serialBuffer[0]) {
        case 'p':
        case 'P':
          value = atof(serialBuffer + 1);
          if (value >= 0) {
            kp = value; // Ajusta o Kp único
            Serial.print(" -> Kp ajustado para: "); Serial.println(kp);
          }
          break;
          
        case 'i':
        case 'I':
          value = atof(serialBuffer + 1);
          if (value >= 0) {
            ki = value;
            Serial.print(" -> Ki ajustado para: "); Serial.println(ki);
          }
          break;
          
        case 'd':
        case 'D':
          value = atof(serialBuffer + 1);
          if (value >= 0) {
            kd = value;
            Serial.print(" -> Kd ajustado para: "); Serial.println(kd);
          }
          break;
          
        case 'k':
        case 'K':
          showMenu();
          break;

        case 'l':
        case 'L':
          Serial.println("\n--- Valores Atuais ---");
          Serial.print("  Kp: "); Serial.println(kp); // Mostra o Kp único
          Serial.print("  Ki: "); Serial.println(ki);
          Serial.print("  Kd: "); Serial.println(kd);
          Serial.println("----------------------");
          break;

        case 'r':
        case 'R':
          // Restaura valores padrão (CORRIGIDO)
          kp = defaultPID.kp;
          ki = defaultPID.ki;
          kd = defaultPID.kd;
          Serial.println(" -> PID resetado para valores padrao!");
          break;
          
        case 's':
        case 'S':
          systemActive = !systemActive;
          Serial.println(systemActive ? " -> Sistema ATIVADO" : " -> Sistema PARADO");
          if (!systemActive) {
            writeServoIfNeeded(SERVO_CENTRO);
            noTone(BUZZER_PIN);
            digitalWrite(LED_PIN, LOW);
          }
          break;
      }
    }
    bufferIndex = 0;
  } else if (bufferIndex < sizeof(serialBuffer) - 1) {
    serialBuffer[bufferIndex++] = c;
  }
}

void loop() {
  unsigned long now = millis();
  if (now - time_prev < PERIOD_MS) {
    processSerialCommand();
    return;
  }
  float dt = (now - time_prev) / 1000.0f;
  if (dt <= 0) dt = 0.001f;
  time_prev = now;

  processSerialCommand();

  if (!systemActive) {
    return;
  }

  // Leitura do sensor "crua", sem filtro
  float distance = read_distance_raw(5); // Reduzi o número de leituras para uma resposta mais rápida

  if (distance >= NO_BALL_CM) {
    writeServoIfNeeded(SERVO_CENTRO);
    digitalWrite(LED_PIN, LOW);
    noTone(BUZZER_PIN);
    PID_i = 0.0f;
    distance_previous_error = 0.0f;
    return;
  }
  
  if (distance < MIN_CONTROL_CM) {
    distance = MIN_CONTROL_CM;
  }

  // Cálculo do erro usando a distância direta
  float error = distance_setpoint - distance;

  if (fabs(error) <= CENTER_DEADBAND) {
    writeServoIfNeeded(SERVO_CENTRO);
    PID_i = 0.0f;
    distance_previous_error = error;
    digitalWrite(LED_PIN, HIGH);
    tone(BUZZER_PIN, BEEP_FREQUENCY); 
    return;
  } else {
    digitalWrite(LED_PIN, LOW); 
    noTone(BUZZER_PIN);
  }

  // --- Lógica do Controlador PID (SIMPLIFICADA) ---
  
  // P: Proporcional (usa o kp único)
  PID_p = kp * error;

  // I: Integral (continua igual)
  PID_i += ki * error * dt;
  PID_i = constrain(PID_i, -INTEGRAL_MAX, INTEGRAL_MAX);

  // D: Derivativo (cálculo direto, sem filtro)
  PID_d = kd * ((error - distance_previous_error) / dt);

  // Soma dos termos
  float pid_output = PID_p + PID_i + PID_d;

  // Saída para o Servo
  int angulo_final = SERVO_CENTRO + (int)round(pid_output);
  angulo_final = constrain(angulo_final, SERVO_MIN_ANGULO, SERVO_MAX_ANGULO);
  writeServoIfNeeded(angulo_final);

  // Guarda o erro atual para o próximo ciclo
  distance_previous_error = error;
}


void writeServoIfNeeded(int ang) {
  if (abs(ang - lastCommandedAngle) >= ANGLE_HYSTERESIS) {
    myservo.write(ang);
    lastCommandedAngle = ang;
  }
}


float read_distance_raw(int n) {
  long sum = 0;
  for (int i = 0; i < n; i++) {
    sum += analogRead(SENSOR_PIN);
    delay(1); // Delay mínimo
  }
  float adc = (float)sum / (float)n;
  float distance_cm = 6787.0 / (adc - 3.0) - 4.0; 
  
  if (distance_cm < 0.0f || distance_cm > 100.0f) {
    return NO_BALL_CM;
  }
  return distance_cm;
}
